<?xml version="1.0" encoding="UTF-8"?>
<!--
  XSD: IMAGE_PROPERTIES  (OIR Section Identifier = 2)
  Namespace : http://www.olympus.co.jp/fluoview/model/lsmimage
  Root      : lsmimage:imageProperties  version="1.1.0.0"

  Namespaces used inside this XML (all from Olympus FluoView):
    lsmimage, base, bi, commonimage, commonparam, lsmparam, opticalelement, roi, xsi

  Structure observed in assignment1-phase1.oir:
    imageProperties (version="1.1.0.0")
      commonimage:general / commonimage:system / commonimage:microscope
      commonimage:lsm → commonimage:laser (×5) → name, id
      lsmimage:acquisition (embedSaturationInfo="false")
        commonimage:objectiveLens, lsmimage:channel (×N), lsmimage:imagingParam
        lsmimage:scannerSettings, lsmimage:lsmConfiguration ...
      commonimage:biProperties → bi:dia, bi:epi ...

  Validation strategy:
    - Validates root element name and namespace (most important check)
    - Validates presence of version attribute
    - xs:any (lax) for all child content — child elements belong to 8 other
      namespaces; importing each would require their schemas too
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:lsmimage="http://www.olympus.co.jp/fluoview/model/lsmimage"
           targetNamespace="http://www.olympus.co.jp/fluoview/model/lsmimage"
           elementFormDefault="qualified">

  <xs:element name="imageProperties">
    <xs:complexType>
      <xs:sequence>
        <xs:any minOccurs="0" maxOccurs="unbounded"
                processContents="lax" namespace="##any"/>
      </xs:sequence>
      <!-- version="1.1.0.0" observed — format: MAJOR.MINOR.PATCH.BUILD -->
      <xs:attribute name="version" type="xs:string" use="optional"/>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
