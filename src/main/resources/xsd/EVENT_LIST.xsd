<?xml version="1.0" encoding="UTF-8"?>
<!--
  OIR EVENT_LIST section schema (Section Identifier = 14)
  Namespace: http://www.olympus.co.jp/fluoview/model/event
  Root element: event:eventList

  Contains the experiment event log: timestamps and descriptions of events
  that occurred during acquisition. Usually empty (self-closing element)
  in files without recorded events.

  Strategy: Lenient — validates root element, accepts any child content.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:event="http://www.olympus.co.jp/fluoview/model/event"
           targetNamespace="http://www.olympus.co.jp/fluoview/model/event"
           elementFormDefault="qualified">

  <xs:element name="eventList">
    <xs:complexType>
      <xs:sequence>
        <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
      </xs:sequence>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
